  "version": "0.2.0",
  "configurations": [
    {
      "name": "Attach to Chrome",
      "port": 8961,
      "request": "attach",
      "type": "chrome",
      "webRoot": "${workspaceFolder}/dist/cep/main"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Launch Chrome against localhost",
      "url": "http://localhost:8961",
      "webRoot": "${workspaceFolder}/dist/cep"
    },
    {
      "type": "extendscript-debug",
      "request": "attach",
      "name": "Attach to ExtendScript Engine",
      "hostAppSpecifier": "aftereffects-24.0"
  },
 
  ],
  "compounds": [
        {
            "name": "[Compound] Debug CEP",
            "configurations": [
                "Launch Chrome against localhost",
                  "Attach to ExtendScript Engine"
            ]
        }
    ]
}
